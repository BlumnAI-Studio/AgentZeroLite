<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build (App Sandbox). build-appstore.sh adds the two identifiers below from
     the provisioning profile. Why each entry is here: Docs/avalonia-v2/macos-distribution.md §4. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>HA39FQRUZG.com.psmon.agentzerolite</string>
    <key>com.apple.developer.team-identifier</key>
    <string>HA39FQRUZG</string>

    <!-- The .NET runtime JIT-compiles. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Loopback servers (xterm renderer, plugins), External LLM providers, web tools. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Workspace folders the person picks with the folder dialog. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- A terminal host: the shells and agent CLIs a person runs in a tab inherit this sandbox.
         Without these, a tab cannot see the person's projects or ~/.claude, cannot run
         node/claude/codex from Homebrew, and `npm install -g` fails (measured, §4.1). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/</string>
    </array>
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/opt/homebrew/</string>
        <string>/usr/local/</string>
    </array>
</dict>
</plist>
