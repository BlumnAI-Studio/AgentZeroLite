<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentZeroAvalonia.ViewModels"
        xmlns:views="using:AgentZeroAvalonia.Views"
        x:Class="AgentZeroAvalonia.Views.CodeWindow"
        x:DataType="vm:CodeViewModel"
        Title="{Binding RootName, StringFormat='Code — {0}'}"
        Icon="avares://AgentZeroLite/Assets/agentzero.ico"
        Width="1000" Height="640" MinWidth="480" MinHeight="240"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <!-- The code view as its own window — the floating bot's arrangement: no state here,
         the DataContext is the same CodeViewModel the docked tab uses. -->
    <Window.Styles>
        <!-- MainWindow's panel-tab look (its styles are window-local). -->
        <Style Selector="Button.ptab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Button.ptab.selected">
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
        </Style>
        <Style Selector="Button.ptab:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.ptab:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- The dock's CODE | GIT LOG | DIFF tabs, for when the panel floats. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="4,2">
            <Button Classes="ptab" Classes.selected="{Binding ShowFilesPane}" Content="📄 CODE"
                    Command="{Binding ShowFilesCommand}" />
            <Button Classes="ptab" Classes.selected="{Binding ShowGitLog}" Content="⎇ GIT LOG"
                    IsEnabled="{Binding GitLog.IsAvailable}" ToolTip.Tip="{Binding GitLog.TabTip}"
                    ToolTip.ShowOnDisabled="True" Command="{Binding ShowHistoryCommand}" />
            <Button Classes="ptab" Classes.selected="{Binding ShowDiff}" Content="± DIFF"
                    Command="{Binding ShowChangesCommand}" />
        </StackPanel>
        <views:CodeView />
    </DockPanel>
</Window>
