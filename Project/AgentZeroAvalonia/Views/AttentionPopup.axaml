<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:AgentZeroAvalonia.Views"
        x:Class="AgentZeroAvalonia.Views.AttentionPopup"
        x:DataType="v:AttentionPopup"
        Title="AgentZero — needs you"
        Width="360" SizeToContent="Height"
        SystemDecorations="None" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent" TransparencyLevelHint="Transparent">

    <!-- The "an agent needs you" corner popup (herdr H2). Its own top-level window, not an
         overlay: an Avalonia surface drawn over a terminal's native web view is invisible on
         macOS, and it must show while another app has the focus. -->
    <Border Background="{DynamicResource CyberBgPanel}" BorderBrush="{DynamicResource CyberCyanBrush}"
            BorderThickness="1" CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseClick" Padding="6,0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextDim}"
                        ToolTip.Tip="Dismiss" />
                <TextBlock Text="AgentZero · needs you" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource CyberCyanBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="v:AttentionPopupItem">
                        <Button Click="OnItemClick" Tag="{Binding}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Background="{DynamicResource CyberBgDeep}"
                                BorderThickness="0" Padding="8,6" Margin="0,0,0,4" Cursor="Hand"
                                ToolTip.Tip="Go to this terminal">
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,4,8,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
